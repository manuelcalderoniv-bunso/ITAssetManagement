{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*", "../frontend/frontend-ui/src/components", "../frontend/frontend-ui/src/api"],
  "exclude": ["node_modules"]
}
